<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_hud"
    android:visibility="visible"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hud_button_help"
        android:layout_width="32dp"
        android:layout_height="22dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1.3"
        android:background="@drawable/b_alt"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.341" />

    <ImageView
        android:id="@+id/hud_button_shop"
        android:layout_width="32dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1.3"
        android:background="@drawable/b_ctrl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/hud_button_help"
        app:layout_constraintStart_toEndOf="@+id/hud_button_help"
        app:layout_constraintTop_toTopOf="@+id/hud_button_help"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_info_layout"
        android:layout_width="@dimen/_160sdp"
        android:layout_height="@dimen/_80sdp"
        android:layout_marginTop="228dp"
        android:layout_marginEnd="192dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/samp_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/radar_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/_115sdp"
        android:layout_height="@dimen/_110sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.01999998">

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="@dimen/_95sdp"
            android:layout_height="@dimen/_95sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:srcCompat="@drawable/bg_weapon" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/weapon_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/imageView12">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/select_weapon"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:background="@drawable/weapon_bg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/weapon_button"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/weapon_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/hud_ammo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_1sdp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="0/0"
                android:textColor="#ffffff"
                android:textSize="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/select_weapon" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/star_1"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="@dimen/_7sdp"
            android:src="@drawable/ic_starnew_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.851" />

        <ImageView
            android:id="@+id/star_2"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="@dimen/_28sdp"
            android:src="@drawable/ic_starnew_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.891" />

        <ImageView
            android:id="@+id/star_3"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="@dimen/_48sdp"
            android:src="@drawable/ic_starnew_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.907" />

        <ImageView
            android:id="@+id/star_4"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="@dimen/_68sdp"
            android:src="@drawable/ic_starnew_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.94" />

        <ImageView
            android:id="@+id/star_5"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="@dimen/_85sdp"
            android:src="@drawable/ic_starnew_off"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.928" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/eat_layout"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginTop="4dp"
            android:background="@drawable/eat_bg"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.041"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/eat_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp"
                android:fontFamily="@font/montserrat_semibold"
                android:text="0%"
                android:textColor="#ffd392"
                android:textSize="@dimen/_5sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/radar_zone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@+id/imageView12"
            app:layout_constraintEnd_toEndOf="@+id/imageView12"
            app:layout_constraintStart_toStartOf="@+id/imageView12"
            app:layout_constraintTop_toTopOf="@+id/imageView12" />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_logo_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/hud_button_inv"
        android:layout_width="31dp"
        android:layout_height="34dp"
        android:layout_weight="1.3"
        android:background="@drawable/button_inv"
        android:visibility="gone"
        tools:layout_editor_absoluteX="505dp"
        tools:layout_editor_absoluteY="377dp" />

    <ImageView
        android:id="@+id/hud_button_menu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:adjustViewBounds="true"
        android:background="@drawable/menu"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.303" />

    <TextView
        android:id="@+id/hud_money"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_11sdp"
        android:background="@drawable/money_bg"
        android:fontFamily="@font/montserrat_semibold"
        android:gravity="right"
        android:paddingRight="@dimen/_5sdp"
        android:text="$ 2,990,000"
        android:textColor="#ffffff"
        android:textSize="@dimen/_7sdp"
        app:layout_constraintEnd_toEndOf="@+id/radar_layout"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/radar_layout"
        app:layout_constraintTop_toBottomOf="@+id/radar_layout" />

    <ImageView
        android:id="@+id/hud_button_star"
        android:layout_width="30dp"
        android:layout_height="20dp"
        android:layout_weight="1.3"
        android:background="@drawable/button_tab"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/hud_money"
        app:layout_constraintEnd_toEndOf="@+id/radar_layout"
        app:layout_constraintHorizontal_bias="0.31"
        app:layout_constraintStart_toEndOf="@+id/hud_money"
        app:layout_constraintTop_toBottomOf="@+id/radar_layout" />

    <TextView
        android:id="@+id/hud_logo_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="@color/black"
        android:shadowRadius="3"
        android:text="ID 999"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/_6sdp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/hud_logo_img"
        app:layout_constraintStart_toEndOf="@+id/hud_logo_img"
        app:layout_constraintTop_toTopOf="@+id/hud_logo_img" />

    <ImageView
        android:id="@+id/hud_logo_img"
        android:layout_width="21dp"
        android:layout_height="19dp"
        android:layout_marginStart="16dp"
        android:adjustViewBounds="true"
        android:src="@drawable/players"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.971" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/armour_layout"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginEnd="88dp"
        android:background="@drawable/armour_bg"
        app:layout_constraintBottom_toBottomOf="@+id/hud_money"
        app:layout_constraintEnd_toEndOf="@+id/hud_money"
        app:layout_constraintTop_toTopOf="@+id/radar_layout"
        app:layout_constraintVertical_bias="0.359">

        <TextView
            android:id="@+id/armour_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="0%"
            android:textColor="#ffffff"
            android:textSize="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/health_layout"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_marginEnd="118dp"
        android:background="@drawable/health_bg"
        app:layout_constraintBottom_toBottomOf="@+id/hud_money"
        app:layout_constraintEnd_toEndOf="@+id/hud_money"
        app:layout_constraintTop_toTopOf="@+id/radar_layout"
        app:layout_constraintVertical_bias="0.359">

        <TextView
            android:id="@+id/health_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="0%"
            android:textColor="#ffb4b4"
            android:textSize="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
