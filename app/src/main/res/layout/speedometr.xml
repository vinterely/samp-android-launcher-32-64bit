<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speed_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="54dp"
        android:layout_height="49dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView13"
        app:layout_constraintEnd_toEndOf="@+id/milleage_text"
        app:layout_constraintStart_toStartOf="@+id/milleage_text"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/speed_bg1" />

    <com.glory.launcher.util.SeekArc
        android:id="@+id/speed_line1"
        android:layout_width="143dp"
        android:layout_height="98dp"
        android:layout_centerHorizontal="true"
        android:padding="@dimen/_5sdp"
        app:arcColor="#00ffffff"
        app:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.12"
        app:max="300"
        app:progress="300"
        app:progressColor="#54000000"
        app:progressWidth="@dimen/_5sdp"
        app:rotation="170"
        app:startAngle="70"
        app:sweepAngle="240"
        app:touchInside="true" />

    <com.glory.launcher.util.SeekArc
        android:id="@+id/speed_line"
        android:layout_width="148dp"
        android:layout_height="98dp"
        android:layout_centerHorizontal="true"
        android:padding="@dimen/_2sdp"
        app:arcColor="#00ffffff"
        app:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.12"
        app:max="300"
        app:progress="300"
        app:progressColor="#B84BDE"
        app:progressWidth="@dimen/_2sdp"
        app:rotation="180"
        app:startAngle="60"
        app:sweepAngle="240"
        app:touchInside="true" />

    <ImageView
        android:id="@+id/engine_start"
        android:layout_width="147dp"
        android:layout_height="97dp"
        android:layout_centerHorizontal="true"
        android:src="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.12" />

    <TextView
        android:id="@+id/speed_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/proximanova_bold"
        android:text="253"
        android:textColor="#ffffff"
        android:textSize="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed_line1"
        app:layout_constraintStart_toStartOf="@+id/speed_line1"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        app:layout_constraintVertical_bias="0.31" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/proximanova_bold"
        android:text="KM/H"
        android:textColor="#54FFFEFE"
        android:textSize="@dimen/_5sdp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed_line1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/speed_line1"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        app:layout_constraintVertical_bias="0.57" />

    <com.glory.launcher.util.SeekArc
        android:id="@+id/fuel_line2"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_71sdp"
        android:layout_centerHorizontal="true"
        android:layout_marginRight="@dimen/_110sdp"
        android:padding="@dimen/_3sdp"
        app:arcColor="#00ffffff"
        app:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.13"
        app:max="100"
        app:progress="100"
        app:progressColor="#33000000"
        app:progressWidth="@dimen/_3sdp"
        app:rotation="250"
        app:startAngle="10"
        app:sweepAngle="110"
        app:touchInside="true" />

    <com.glory.launcher.util.SeekArc
        android:id="@+id/fuel_line"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_71sdp"
        android:layout_centerHorizontal="true"
        android:layout_marginRight="@dimen/_110sdp"
        android:padding="@dimen/_3sdp"
        app:arcColor="#00ffffff"
        app:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.13"
        app:max="100"
        app:progress="100"
        app:progressColor="#f88903"
        app:progressWidth="@dimen/_2sdp"
        app:rotation="250"
        app:startAngle="10"
        app:sweepAngle="110"
        app:touchInside="true" />

    <ImageView
        android:id="@+id/fuel_type"
        android:layout_width="@dimen/_7sdp"
        android:layout_height="@dimen/_7sdp"
        app:layout_constraintBottom_toTopOf="@+id/fuel_text"
        app:layout_constraintEnd_toEndOf="@+id/fuel_line2"
        app:layout_constraintHorizontal_bias="0.38"
        app:layout_constraintStart_toStartOf="@+id/fuel_line2"
        app:layout_constraintTop_toTopOf="@+id/fuel_line2"
        app:layout_constraintVertical_bias="1"
        app:srcCompat="@drawable/ico_petrol" />
    <TextView
        android:textColor="#ffffff"
        android:id="@+id/fuel_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:fontFamily="@font/proximanova_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/fuel_line2"
        app:layout_constraintHorizontal_bias="0.38"
        app:layout_constraintStart_toStartOf="@+id/fuel_line2"
        app:layout_constraintTop_toTopOf="@+id/fuel_line2"
        app:layout_constraintVertical_bias="0.95"/>
    <TextView
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/milleage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0000000"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/montserrat_regular"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed_line1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/speed_line1"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        android:background="@drawable/mileage_bg"
        app:layout_constraintVertical_bias="0.749"/>

    <com.glory.launcher.util.SeekArc
        android:id="@+id/hp_line2"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_71sdp"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="@dimen/_110sdp"
        android:padding="@dimen/_3sdp"
        android:rotationY="180"
        app:arcColor="#00ffffff"
        app:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.13"
        app:max="100"
        app:progress="100"
        app:progressColor="#54000000"
        app:progressWidth="@dimen/_3sdp"
        app:rotation="210"
        app:startAngle="38"
        app:sweepAngle="120"
        app:touchInside="true" />

    <com.glory.launcher.util.SeekArc
        android:id="@+id/hp_line"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="@dimen/_71sdp"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="@dimen/_110sdp"
        android:padding="@dimen/_3sdp"
        android:rotationY="180"
        app:arcColor="#00ffffff"
        app:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.13"
        app:max="100"
        app:progress="100"
        app:progressColor="#ff0000"
        app:progressWidth="@dimen/_2sdp"
        app:rotation="210"
        app:startAngle="38"
        app:sweepAngle="120"
        app:touchInside="true" />

    <ImageView
        android:id="@+id/hp_type"
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@+id/hp_text"
        app:layout_constraintEnd_toEndOf="@+id/hp_line2"
        app:layout_constraintHorizontal_bias="0.69"
        app:layout_constraintStart_toStartOf="@+id/hp_line2"
        app:layout_constraintTop_toTopOf="@+id/hp_line2"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/ic_speed_hp" />

    <TextView
        android:id="@+id/hp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/proximanova_bold"
        android:text="0"
        android:textColor="#ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/hp_line2"
        app:layout_constraintHorizontal_bias="0.69"
        app:layout_constraintStart_toStartOf="@+id/hp_line2"
        app:layout_constraintTop_toTopOf="@+id/hp_line2"
        app:layout_constraintVertical_bias="0.95" />
    <ImageView
        android:id="@+id/speed_engine"
        android:layout_width="@dimen/_7sdp"
        android:layout_height="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed_line1"
        app:layout_constraintHorizontal_bias="0.4"
        app:layout_constraintStart_toStartOf="@+id/speed_line1"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        app:layout_constraintVertical_bias="0.95"
        app:srcCompat="@drawable/ico_engine_off"/>
    <ImageView
        android:id="@+id/speed_lights"
        android:layout_width="@dimen/_7sdp"
        android:layout_height="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed_line1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/speed_line1"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        app:layout_constraintVertical_bias="0.95"
        app:srcCompat="@drawable/ico_lights_off"/>
    <ImageView
        android:id="@+id/speed_doors"
        android:layout_width="@dimen/_7sdp"
        android:layout_height="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/speed_line1"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toStartOf="@+id/speed_line1"
        app:layout_constraintTop_toTopOf="@+id/speed_line1"
        app:layout_constraintVertical_bias="0.95"
        app:srcCompat="@drawable/ico_lock_off"/>

    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_8sdp"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/milleage_text"
        app:layout_constraintStart_toStartOf="@+id/milleage_text"
        app:layout_constraintTop_toBottomOf="@+id/milleage_text"
        app:layout_constraintVertical_bias="0.56"
        app:srcCompat="@drawable/speedometer_status_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>